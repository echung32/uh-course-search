# Base URL for the UH Banner SSB9 Student Information System
# Copy this file to .env and adjust if needed.
SIS_BASE_URL=https://www.sis.hawaii.edu:9234/StudentRegistrationSsb

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare D1 persistent data layer (see docs/plans/d1-persistence.md)
# database_id of the `uh_sis` D1 database (from `wrangler d1 create uh_sis`).
D1_DATABASE_ID=
# Analytics rollup DB (uh-analytics-db) — separate database_id, same account/token.
ANALYTICS_DATABASE_ID=
# "local" (default outside production) reads the wrangler local D1 file under
# .wrangler/state; "remote" uses the D1 REST API and needs the three vars above.
D1_MODE=local

# Home backend (deploy/home/). The ingestion CLI / gateway / backups target these
# SQLite files directly when D1_MODE=local (otherwise the wrangler local state).
# SEARCH_D1_LOCAL_FILE=/data/db/search.sqlite
# ANALYTICS_D1_LOCAL_FILE=/data/db/analytics.sqlite
# GATEWAY_SECRET=            # gateway bearer secret (openssl rand -hex 32)
#
# Worker secrets (wrangler secret put …), not read from this file:
#   DB_GATEWAY_URL, DB_GATEWAY_SECRET, CF_ACCESS_CLIENT_ID, CF_ACCESS_CLIENT_SECRET

# Shared secret guarding the /api/admin/* ingestion + seat-refresh routes.
# Sent as the `x-admin-secret` header. Generate with: openssl rand -hex 32
ADMIN_SECRET=

# Cache-on-miss toggles (the only live-Banner calls on a user request).
# DYNAMIC_SYNC=0 disables the demand-driven page cache for un-backfilled terms —
# the live, sort-aware per-page section fetch on /api/search (also gates the
# lazy subject-menu enumeration); SECTION_LAZY_FETCH=0 disables lazy section detail
# (/api/section); COURSE_TEXT_LAZY=0 disables lazy course text — description /
# prerequisites / corequisites — on first panel view (/api/course). All default on.
# DYNAMIC_SYNC=1
# SECTION_LAZY_FETCH=1
# COURSE_TEXT_LAZY=1
# LAZY_FETCH_PER_MINUTE=30   # per-isolate cap on on-view live Banner fetches (section/course panels)

# Class Availability API (crseavail) for course facts + cross-lists, with
# automatic per-unit Banner fallback. 1 = on; unset/anything else = Banner only.
# CRSEAVAIL=1
# CRSEAVAIL_BASE_URL=https://www.sis.hawaii.edu:9350/crseavail/api

# Daily refresh per-run caps, per term (positive integers; else the default).
# Stalest-first by each fragment's own stamp, never-fetched first.
# REFRESH_ROLLING_RESTRICTION_CRNS=500   # restrictions (1 Banner call/CRN)
# REFRESH_ROLLING_EXTRAS_CRNS=300        # fees + linked + syllabus (3 calls/CRN)
# REFRESH_ROLLING_PREREQ_COURSES=150     # prereqs + coreqs (2 calls/course)
# REFRESH_ROLLING_FACTS_COURSES=150      # Banner fallback for course facts (2 calls/course)
# Retired single Tier B2 cap; still honoured as the restrictions cap when
# REFRESH_ROLLING_RESTRICTION_CRNS is unset.
# REFRESH_ROLLING_DETAIL_CRNS=250

# Dev-log source tags: [DB] = served from D1, [SIS] = live Banner call.
# Set LOG_SOURCE=0 to silence them.
# LOG_SOURCE=1