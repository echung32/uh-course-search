# Copy to deploy/home/.env (git-ignored) and fill in. Read by both services.

# Bearer secret the Worker sends (Worker secret DB_GATEWAY_SECRET = same value).
# Generate with: openssl rand -hex 32
GATEWAY_SECRET=

# Live database files (inside the container; ./data is mounted at /data).
SEARCH_D1_LOCAL_FILE=/data/db/search.sqlite
ANALYTICS_D1_LOCAL_FILE=/data/db/analytics.sqlite

# Banner host the daily refresh scrapes.
SIS_BASE_URL=https://www.sis.hawaii.edu:9234/StudentRegistrationSsb

# Tier B2 rolling detail cap per term per run. 1500 matches the value the Worker
# ran with (wrangler.jsonc vars) — a ~9k-section term cycles its details in ~6
# nights. The code default is 250 (~36 nights).
REFRESH_ROLLING_DETAIL_CRNS=1500

# Class Availability portal (crseavail) for course facts + cross-lists, with
# automatic per-unit Banner fallback. 1 = on; unset/anything else = Banner only
# (the kill switch). CRSEAVAIL_BASE_URL overrides the endpoint (rarely needed).
CRSEAVAIL=1
# CRSEAVAIL_BASE_URL=https://www.sis.hawaii.edu:9350/crseavail/api

# Time budget (minutes) for each scheduled capture run (run-capture.sh). A run
# never goes past 21:45 HST when started before it, whatever this says.
# CAPTURE_MAX_MINUTES=180

# Days of nightly VACUUM INTO backups kept in /data/backups (default 14). Lower it
# if another job already copies /data/backups offsite with its own retention.
# BACKUP_KEEP_DAYS=14

# [DB]/[SIS] source tags in logs; 0 silences them.
LOG_SOURCE=0
